Diagnostic: dump tx_free fields when WARN_ON_ONCE fires in mt7996_mac_tx_free.
Prints version, first dwords, and overrun delta to pin down why the NPU's
TXRX_NOTIFY parser hits the warn paths. Stays inside the if-blocks so it only
fires when the WARN condition is true; the WARN itself still prints once.

--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -1305,16 +1305,23 @@
 	}
 
 	ver = le32_get_bits(tx_free[1], MT_TXFREE1_VER);
-	if (WARN_ON_ONCE(ver < 5))
+	if (WARN_ON_ONCE(ver < 5)) {
+		pr_warn("mt7996: tx_free bad ver=%u dw0=0x%08x dw1=0x%08x len=%d\n",
+			ver, le32_to_cpu(tx_free[0]),
+			le32_to_cpu(tx_free[1]), len);
 		return;
+	}
 
 	total = le32_get_bits(tx_free[0], MT_TXFREE0_MSDU_CNT);
 	for (cur_info = &tx_free[2]; count < total; cur_info++) {
 		u32 msdu, info;
 		u8 i;
 
-		if (WARN_ON_ONCE((void *)cur_info >= end))
+		if (WARN_ON_ONCE((void *)cur_info >= end)) {
+			pr_warn("mt7996: tx_free overrun count=%u total=%u over_by=%zd len=%d ver=%u\n",
+				count, total, (ssize_t)((void *)cur_info - end), len, ver);
 			return;
+		}
 		/* 1'b1: new wcid pair.
 		 * 1'b0: msdu_id with the same 'wcid pair' as above.
 		 */
